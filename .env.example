# Copia este ficheiro para .env e preenche. O .env NUNCA vai para o Git.

# --- Ollama (modelo local) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:12b

# --- PostgreSQL (tem de bater com o docker-compose.yml) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# ATENÇÃO: tem de ser igual à dimensão em scripts/init.sql (vector(384)).
EMBEDDING_DIM=384

# --- Pipeline ---
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=5
