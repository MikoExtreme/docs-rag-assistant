# Copia este ficheiro para .env e preenche. O .env NUNCA vai para o Git.

# --- Claude API ---
ANTHROPIC_API_KEY=
# Confirma o nome do modelo na documentação da Anthropic antes de correr.
CLAUDE_MODEL=claude-sonnet-5-5

# --- PostgreSQL (tem de bater com o docker-compose.yml) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# ATENÇÃO: tem de ser igual à dimensão em scripts/init.sql (vector(384)).
EMBEDDING_DIM=384

# --- Pipeline ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
